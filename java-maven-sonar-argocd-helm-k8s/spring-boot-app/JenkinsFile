pipeline {
  agent {
    docker {
      // এটি Jenkins-এর build-tools image, application image নয়।
      image 'jenkins-maven-docker-agent:29.1.3'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
    }
  }

  stages {
    stage('Checkout') {
      steps {
        sh 'echo Checkout Starting'

        git branch: 'main',
            url: 'https://github.com/Sameurxd/Jenkins-Zero-To-Hero.git'
      }
    }

    stage('Build and Test') {
      steps {
        sh 'ls -ltr'

        sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn -B clean package'
      }
    }

    stage('Static Code Analysis') {
      environment {
        SONAR_URL = 'http://47.129.31.72:9000'
      }

      steps {
        withCredentials([
          string(
            credentialsId: 'sonarqube-local-token',
            variable: 'SONAR_AUTH_TOKEN'
          )
        ]) {
          sh '''
            cd java-maven-sonar-argocd-helm-k8s/spring-boot-app

            mvn -B org.sonarsource.scanner.maven:sonar-maven-plugin:5.2.0.4988:sonar \
              -Dsonar.token="$SONAR_AUTH_TOKEN" \
              -Dsonar.host.url="$SONAR_URL" \
              -Dsonar.projectKey=spring-boot-app
          '''
        }
      }
    }

    stage('Build and Push Docker Image') {
      environment {
        DOCKER_IMAGE = "imsameur/spring-boot-app:${BUILD_NUMBER}"
      }

      steps {
        script {
          sh '''
            cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
            docker build -t "$DOCKER_IMAGE" .
          '''

          def dockerImage = docker.image("${DOCKER_IMAGE}")

          docker.withRegistry(
            'https://index.docker.io/v1/',
            'docker-cred'
          ) {
            dockerImage.push()
          }
        }
      }
    }

    stage('Update Deployment File') {
      environment {
        GIT_REPO_NAME = 'Jenkins-Zero-To-Hero'
        GIT_USER_NAME = 'Sameurxd'
        DOCKER_IMAGE = "imsameur/spring-boot-app:${BUILD_NUMBER}"
        MANIFEST_FILE = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml'
      }

      steps {
        withCredentials([
          string(
            credentialsId: 'github',
            variable: 'GITHUB_TOKEN'
          )
        ]) {
          sh '''
            set +x
            set -e

            git config user.email "jenkins@users.noreply.github.com"
            git config user.name "$GIT_USER_NAME"

            sed -i -E "s|(^[[:space:]]*image:[[:space:]]*).*|\\1${DOCKER_IMAGE}|" "$MANIFEST_FILE"

            git add "$MANIFEST_FILE"
            git commit -m "Update deployment image to version ${BUILD_NUMBER}"

            git push "https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git" HEAD:main
          '''
        }
      }
    }
  }
}
